# ==========================================================
#  AI 平台配置模板——复制为 .env 后填写；真正的 .env 不进 Git 仓库
#  必须修改的只有 3 项：ZHIPU_API_KEY、GATE_ADMIN_PASSWORD、GATE_VIEWER_PASSWORD
#  其余「请生成随机值」各填一个随机字符串（PowerShell 执行 [guid]::NewGuid() 可得）。改完后在 Container Manager 里重新构建项目。
# ==========================================================

# ---- 必填 ----
ZHIPU_API_KEY=
GATE_ADMIN_PASSWORD=
GATE_VIEWER_PASSWORD=

# ---- NAS 与访问地址 ----
NAS_VOLUME=/volume1
WEBUI_PORT=8030
GATE_PORT=8031
WEBUI_URL=http://<NAS-IP>:8030

# ---- 镜像（ghcr.io 拉不下来时，按手册换成国内镜像地址）----
IMAGE_OPENWEBUI=ghcr.io/open-webui/open-webui:v0.11.3
IMAGE_TERMINAL=ghcr.io/open-webui/open-terminal:0.13.0

# ---- 部门月预算（元），示例值；首次启动写入，之后在费用管理页修改 ----
BUDGET_ZC=50
BUDGET_CW=50
BUDGET_YX=50
BUDGET_ZB=50

# ---- 智谱单价（元 / 百万 tokens，GLM-5.3-Flash 官方价格页）----
PRICE_INPUT=0.8
PRICE_OUTPUT=2.8
PRICE_CACHED=0.23

# ---- 部门终端容器内的运行账号 = NAS 上给终端建的服务账号（id <账号名> 查看）----
TERM_UID=1000
TERM_GID=100

# ---- 用量保护（可选，不写用默认：单个对话 ¥5，单次输入 10 万 tokens；0 = 不限）----
# CHAT_MAX_YUAN=5
# MAX_INPUT_TOKENS=100000

# ---- 以下为自动生成的内部密钥，部署后不要再改（改了需同步 Open WebUI 连接设置）----
WEBUI_SECRET_KEY=请生成随机值
DEPT_KEY_ZC=请生成随机值
DEPT_KEY_CW=请生成随机值
DEPT_KEY_YX=请生成随机值
DEPT_KEY_ZB=请生成随机值
TERM_KEY_ZC=请生成随机值
TERM_KEY_CW=请生成随机值
TERM_KEY_YX=请生成随机值
TERM_KEY_ZB=请生成随机值
